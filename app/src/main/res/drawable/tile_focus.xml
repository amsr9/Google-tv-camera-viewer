<?xml version="1.0" encoding="utf-8"?>
<!-- Blue frame drawn ON TOP of the selected camera, so tiles need no margin. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#2196F3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="0.5dp" android:color="#40000000" />
        </shape>
    </item>
</selector>
