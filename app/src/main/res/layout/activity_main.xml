<?xml version="1.0" encoding="utf-8"?>
<!-- Cameras use the whole screen; the top bar floats over them and hides itself. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:maxWidth="640dp"
        android:padding="24dp"
        android:textColor="#ECEFF1"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- NVR health problems: always visible while there is one -->
    <TextView
        android:id="@+id/warning_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="#E6B71C1C"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/page_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#CFD8DC"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_layout"
            style="@style/TopBarButton"
            android:nextFocusLeft="@id/btn_layout"
            android:nextFocusUp="@id/btn_layout"
            android:text="Layout" />

        <Button
            android:id="@+id/btn_events"
            style="@style/TopBarButton"
            android:nextFocusUp="@id/btn_events"
            android:text="Events" />

        <Button
            android:id="@+id/btn_refresh"
            style="@style/TopBarButton"
            android:nextFocusUp="@id/btn_refresh"
            android:text="Refresh" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/TopBarButton"
            android:nextFocusRight="@id/btn_settings"
            android:nextFocusUp="@id/btn_settings"
            android:text="Settings" />
    </LinearLayout>
</FrameLayout>
